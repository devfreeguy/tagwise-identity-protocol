# Template for the server's real .env at /opt/apps/tagwise/.env.
#
# Copy this to /opt/apps/tagwise/.env ONCE during first-time server setup, fill
# in real values, then leave it alone -- the deploy workflow never
# overwrites, reads, or uploads this file. Never commit a filled-in copy.
#
# IMAGE_OWNER, REPO_NAME, and IMAGE_TAG are NOT set here: deploy.sh exports
# them itself before every `docker compose` call (IMAGE_TAG is the git SHA
# being deployed, different every run), so they don't belong in a static
# file. Do not add them here.
#
# postgres and redis are pre-existing containers with real
# production data -- this file does NOT define or configure them (see
# deploy/compose.yml's header). Confirmed via production inspection
# (docker inspect tip-api / postgres / redis), NOT invented:
#   - postgres and redis both run on a Docker network named
#     "alpha"; container-name DNS resolves them by that name.
#   - tip-api's DATABASE_URL is postgresql://tip_user:<password>@postgres:5432/tip_db
#   - tip-api's REDIS_URL is redis://:<password>@redis:6379
#   - REDIS_KEY_PREFIX is tip:
# The passwords themselves are real production credentials and were
# deliberately not captured anywhere in this repository -- fill them into
# this file only after copying it to /opt/apps/tagwise/.env on the server itself
# (chmod 600), never into a committed file.

# ---- Existing infrastructure (do not create/modify -- see compose.yml) ----
# Used by compose.yml's `networks: infra: name: ${EXISTING_INFRA_NETWORK}`
# substitution. Because api/indexer also use `env_file: .env`, this value
# is incidentally passed into their process environment too -- harmless,
# neither app reads a variable by this name.
EXISTING_INFRA_NETWORK=alpha

# ---- Shared by api and indexer ---------------------------------------------
# Host, port, username, and database/prefix below are the real, confirmed
# values -- only the passwords are placeholders (real production
# credentials, deliberately not put in this file).
DATABASE_URL=postgresql://tip_user:REPLACE_WITH_DATABASE_PASSWORD@postgres:5432/tip_db
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379
# Must be identical for api and indexer -- both read it from this one file,
# so that's automatic here, but do not override it anywhere else.
REDIS_KEY_PREFIX=tip:
TIP_REGISTRY_PROGRAM_ID="4vcgrBuzoWw3kBanVTtx7Pi1v9WyTJBJQsFAQMqjJZjx"

# ---- apps/api only ----------------------------------------------------------
JWT_SECRET="replace-with-a-long-random-secret"
PAYMENT_LINK_BASE_URL="https://tagwise.me"
AUTH_DOMAIN="tagwise.me"
AUTH_TOKEN_TTL="1h"
AUTH_NONCE_TTL="300"
THROTTLE_TTL="60"
THROTTLE_LIMIT="5"
REGISTER_THROTTLE_TTL="60"
REGISTER_THROTTLE_LIMIT="3"
IDENTITY_UPDATE_THROTTLE_TTL="60"
IDENTITY_UPDATE_THROTTLE_LIMIT="10"
RESOLVE_CACHE_TTL="300"
RESOLVE_CACHE_NEGATIVE_TTL="30"
# Secret: embeds the Helius api-key in the URL's query string. Full URL,
# not just the bare key -- apps/api has no HELIUS_API_KEY-based derivation.
# devnet shown here to match the project's current deployed network (see
# README.md); change to mainnet only when the project itself does.
RPC_HTTP_URL="https://devnet.helius-rpc.com/?api-key=replace-with-real-key"
# Real browser-facing origins allowed to call this API cross-origin (e.g.
# the docs playground, the main tagwise.me site) -- NOT api.tagwise.me or
# tip.tagwise.me themselves. Comma-separated, no spaces needed but
# tolerated. Leaving this unset/empty defaults to "*" (see
# apps/api/src/config/config.service.ts) -- set real values in production.
ALLOWED_ORIGINS="https://tagwise.me,https://docs.tagwise.me"

# ---- apps/indexer only -------------------------------------------------------
# Either set RPC_HTTP_URL/RPC_WSS_URL directly, or set HELIUS_API_KEY and
# both are derived for devnet automatically (explicit URLs win if both are
# set). apps/api's RPC_HTTP_URL above is separate and independent.
HELIUS_API_KEY="replace-with-real-key"
COMMITMENT="finalized"
RECONCILE_CRON="0 3 * * *"
LOG_LEVEL="info"
