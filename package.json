{
  "name": "tip",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:docs": "turbo run build --filter=@tip/api... --filter=@tip/docs... && pnpm --filter @tip/api export:openapi && pnpm --filter @tip/docs build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "turbo run format",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "2.10.5",
    "typescript": "6.0.3"
  }
}
