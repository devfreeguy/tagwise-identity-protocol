# Copy this file to .env and fill in real values. Never commit real credentials.

# Either set RPC_HTTP_URL and RPC_WSS_URL directly...
RPC_HTTP_URL="https://api.devnet.solana.com"
RPC_WSS_URL="wss://api.devnet.solana.com"

# ...or set HELIUS_API_KEY and the devnet Helius URLs are built from it. If
# both RPC_HTTP_URL/RPC_WSS_URL and HELIUS_API_KEY are set, the explicit URLs
# win.
HELIUS_API_KEY=""

# The deployed tip_registry devnet program id. Never hardcoded in source.
TIP_REGISTRY_PROGRAM_ID="4vcgrBuzoWw3kBanVTtx7Pi1v9WyTJBJQsFAQMqjJZjx"

# Direct Postgres connection string for the mirror database.
DATABASE_URL="postgresql://user:password@localhost:5432/tip"

# Commitment level for reads and subscriptions. Defaults to finalized.
COMMITMENT="finalized"

# Cron expression for the nightly reconcile sweep. Defaults to once daily.
RECONCILE_CRON="0 3 * * *"

# Optional: pino log level.
LOG_LEVEL="info"
