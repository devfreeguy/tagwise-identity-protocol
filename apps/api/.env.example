# Copy this file to .env and fill in real values. Never commit real credentials.

# Port the Fastify server listens on.
PORT="3000"

# Direct Postgres connection string for the mirror database.
DATABASE_URL="postgresql://user:password@localhost:5432/tip"

# Base URL used to build payment links, for example PAYMENT_LINK_BASE_URL + "/@" + tag.
PAYMENT_LINK_BASE_URL="https://tagwise.me"
