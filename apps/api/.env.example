# Copy this file to .env and fill in real values. Never commit real credentials.

# Port the Fastify server listens on.
PORT="3000"

# Direct Postgres connection string for the mirror database.
DATABASE_URL="postgresql://user:password@localhost:5432/tip"

# Base URL used to build payment links, for example PAYMENT_LINK_BASE_URL + "/@" + tag.
PAYMENT_LINK_BASE_URL="https://tagwise.me"

# Secret used to sign session JWTs. Required, no default: a weak or shared
# secret lets anyone forge sessions. Use a long random value, never reuse
# across environments.
JWT_SECRET="replace-with-a-long-random-secret"

# Domain/statement shown in the sign-in message for domain separation, so a
# signature requested by this API cannot be replayed against another site.
AUTH_DOMAIN="tagwise.me"

# Session token lifetime, in jsonwebtoken/ms duration format (for example "1h").
AUTH_TOKEN_TTL="1h"

# Nonce lifetime in seconds: how long a caller has to sign and submit the
# challenge before it expires.
AUTH_NONCE_TTL="300"

# Rate limit for auth endpoints: THROTTLE_LIMIT requests per THROTTLE_TTL seconds.
THROTTLE_TTL="60"
THROTTLE_LIMIT="5"

# The deployed tip_registry program id. Never hardcoded in source.
TIP_REGISTRY_PROGRAM_ID="4vcgrBuzoWw3kBanVTtx7Pi1v9WyTJBJQsFAQMqjJZjx"

# HTTP RPC endpoint used to build transactions, fetch blockhashes, rent, and
# balances. Matches the naming already used by apps/indexer.
RPC_HTTP_URL="https://api.devnet.solana.com"

# Rate limit for POST /v1/register, keyed on IP and authenticated pubkey
# together: REGISTER_THROTTLE_LIMIT requests per REGISTER_THROTTLE_TTL seconds.
REGISTER_THROTTLE_TTL="60"
REGISTER_THROTTLE_LIMIT="3"

# Rate limit for PATCH /v1/identity/:tag, keyed on the authenticated pubkey
# only: IDENTITY_UPDATE_THROTTLE_LIMIT requests per IDENTITY_UPDATE_THROTTLE_TTL seconds.
IDENTITY_UPDATE_THROTTLE_TTL="60"
IDENTITY_UPDATE_THROTTLE_LIMIT="10"

# Redis connection string, required with no default: auth nonces and rate
# limit counters are Redis-backed only, never in-memory, so a missing
# REDIS_URL fails fast at startup rather than silently degrading. Use
# rediss:// (not redis://) for hosted providers that require TLS.
REDIS_URL="redis://localhost:6379"

# Prefix applied to every key this API writes to Redis, so one Redis instance
# can be shared safely across concerns and keys stay debuggable.
#
# CRITICAL: this MUST be identical to apps/indexer's REDIS_KEY_PREFIX. The
# API writes the resolve cache key with this prefix (via @tip/core's
# buildResolveCacheKey) and the indexer deletes it with its own copy of the
# same prefix. If the two ever differ, invalidation silently misses: the
# indexer deletes a key that does not match anything the API wrote, stale
# data is served until TTL expires, and nothing anywhere raises an error.
REDIS_KEY_PREFIX="tip:"

# TTL (seconds) for a cached positive resolve response. This is a backstop
# only, not the correctness mechanism: apps/indexer actively invalidates the
# exact key on every applied mirror change, so a stale cache entry should
# normally never survive to see this TTL expire.
RESOLVE_CACHE_TTL="300"

# TTL (seconds) for a cached negative resolve response (tag not found),
# deliberately shorter than RESOLVE_CACHE_TTL: it blunts enumeration spam
# without masking a newly registered tag for as long as a positive entry
# would. Also used for a chain-fallback hit's cache entry (an anomaly that
# should be re-verified against the mirror soon), see tags.service.ts.
RESOLVE_CACHE_NEGATIVE_TTL="30"

# Comma-separated list of browser origins allowed to make cross-origin
# requests to the API (CORS). In development you can leave this as "*" (the
# default). In production, set it to the docs site URL so only the playground
# in the docs can call the API from a browser, for example:
#   ALLOWED_ORIGINS="https://tip-docs.vercel.app"
# Multiple origins:
#   ALLOWED_ORIGINS="https://tip-docs.vercel.app,https://tagwise.me"
ALLOWED_ORIGINS="*"
