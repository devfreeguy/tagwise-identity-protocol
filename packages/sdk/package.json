{
  "name": "@tagwise/tip-sdk",
  "version": "0.2.0",
  "description": "Client SDK for the TIP (tagwise identity protocol) API and Solana program",
  "type": "module",
  "license": "MIT",
  "homepage": "https://docs.tagwise.me",
  "repository": {
    "type": "git",
    "url": "https://github.com/devfreeguy/tagwise-identity-protocol.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/devfreeguy/tagwise-identity-protocol/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "echo \"no formatter configured yet\"",
    "prepack": "npm pkg delete \"devDependencies.@tip/core\"",
    "postpack": "npm pkg set \"devDependencies.@tip/core=workspace:*\""
  },
  "dependencies": {
    "@solana/addresses": "^7.0.0",
    "@solana/kit": "^7.0.0"
  },
  "devDependencies": {
    "@tip/core": "workspace:*",
    "@types/node": "24.13.3",
    "tsdown": "0.22.13",
    "vitest": "4.1.10"
  }
}
