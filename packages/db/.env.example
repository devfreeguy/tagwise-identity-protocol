# Copy this file to .env and fill in real values. Never commit real credentials.

# Direct Postgres connection string used by the driver adapter at runtime and
# by `prisma migrate deploy`. Example shape for a hosted provider such as
# Neon or Render:
# postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/tip"

# Connection string for the shadow database Prisma Migrate uses to detect
# schema drift. Point this at a separate, disposable database, never at the
# same database as DATABASE_URL.
SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/tip_shadow"
